[sub_resource type="Resource" id="q16"]
script = ExtResource("2")
say = "Bigger items need a little extra to craft. You'll need to spend an [b]ORGANIC[/b] element {suit:organic} to craft the Salmon."
place = "top"
spot = PackedStringArray("cp:costs")

[sub_resource type="Resource" id="q17"]
