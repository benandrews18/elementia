[sub_resource type="Resource" id="q0"]
script = ExtResource("2")
mouse = "reacting_wave_hello"
say = "[font_size=22][b]Welcome to[/b][/font_size]
[font_size=34][b][color=#b5541b]ELEMENTIA![/color][/b][/font_size]

You're a curious [b]scientist[/b] {🧪}
exploring the [b]world[/b] {🌍}
for chemical [b][color=#b5541b]elements[/color][/b] {__CONVERT__}
to build new [b]creations[/b] {🛠️}"

[sub_resource type="Resource" id="q1"]
script = ExtResource("2")
mouse = "props_unfold_map"
say = "This is the [b]world map[/b] {🗺️}. You'll use this to find your way around the world of Elementia!"
place = "high"

[sub_resource type="Resource" id="q2"]
script = ExtResource("2")
