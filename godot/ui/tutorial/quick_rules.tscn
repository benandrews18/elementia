[ext_resource type="Script" path="res://ui/tutorial/quick_step.gd" id="2"]
[ext_resource type="Shader" path="res://ui/theme/spotlights.gdshader" id="3"]

[sub_resource type="ShaderMaterial" id="shade"]
shader = ExtResource("3")

[sub_resource type="Resource" id="q0"]
script = ExtResource("2")
say = "Welcome to [b]Elementia[/b]! In this game, you play as a curious scientist {🧪} who explores the world {🌍} searching for chemical elements {__CONVERT__} to help you build new creations {🛠️}"

[sub_resource type="Resource" id="q1"]
script = ExtResource("2")
say = "This is the [b]world map[/b] {🗺️}. You'll use this to find your way around the world of Elementia!"
place = "high"

[sub_resource type="Resource" id="q2"]
script = ExtResource("2")
say = "There are [b]8[/b] unique locations to visit.
{stations}
This one is the [b]Old Growth Forest[/b]! {🌲}"
place = "top"
act = PackedStringArray("station:Old Growth Forest")
spot = PackedStringArray("map:Old Growth Forest")

[sub_resource type="Resource" id="q3"]
script = ExtResource("2")
say = "Each location has its own pool of elements to gather {🧺}. You'll need to visit all 8 stations to gather all the elements!"
place = "bottom"
act = PackedStringArray("mapcard:Old Growth Forest")
extra = "elements"

[sub_resource type="Resource" id="q4"]
script = ExtResource("2")
say = "This is the [b]center button[/b]! You'll be tapping this button to move around {🥾}, gather elements {🧺}, and more {ui:discard}"
place = "bottom"
act = PackedStringArray("mapcard:", "hub")
spot = PackedStringArray("hub:home")

[sub_resource type="Resource" id="q5"]
script = ExtResource("2")
say = "This is your [b]Inventory[/b] {ui:inventory}. You'll store all your elements and items in here!"
place = "bottom"
act = PackedStringArray("slide:inv")
spot = PackedStringArray("hub:inv")

[sub_resource type="Resource" id="q6"]
script = ExtResource("2")
say = "You can find information about all the items in the game using this guide book {ui:items}"
place = "bottom"
act = PackedStringArray("slide:codex")
spot = PackedStringArray("hub:codex")

[sub_resource type="Resource" id="q7"]
script = ExtResource("2")
say = "Use the [b]To-Do List[/b] {ui:todo} to keep track of what items you want to create {📌} and where to craft them {🛠️}"
place = "bottom"
act = PackedStringArray("slide:jobs")
spot = PackedStringArray("hub:jobs")

[sub_resource type="Resource" id="q8"]
script = ExtResource("2")
say = "This is the [b]Market[/b] {ui:market}. There's always lots to see there! Let's check it out now."
place = "bottom"
act = PackedStringArray("slide:market")
spot = PackedStringArray("hub:market")

[sub_resource type="Resource" id="q9"]
script = ExtResource("2")
say = "The Market is full of rewards {🎁} to help you on your journey!"
place = "bottom"
act = PackedStringArray("market")

[sub_resource type="Resource" id="q10"]
script = ExtResource("2")
say = "Visit all 8 stations
{stations}"
place = "bottom"
spot = PackedStringArray("market:stations")

[sub_resource type="Resource" id="q11"]
script = ExtResource("2")
say = "Craft items found in the Market. You can even craft Market items directly from the Marketplace!"
place = "bottom"
spot = PackedStringArray("market:market")

[sub_resource type="Resource" id="q12"]
script = ExtResource("2")
say = "These are the [b]Capstone[/b] items. The biggest items in the game! You'll need items from almost every station to craft these. They give HUGE point bonuses and even game-changing effects!"
place = "top"
act = PackedStringArray("scroll:market:name:Ecosystem")
spot = PackedStringArray("market:caps")

[sub_resource type="Resource" id="q13"]
script = ExtResource("2")
say = "Let's take a closer look at one now."
place = "top"
spot = PackedStringArray("market:name:Ecosystem")

[sub_resource type="Resource" id="q14"]
script = ExtResource("2")
say = "This is the [b]Ecosystem[/b]. It's the capstone of the Old Growth Forest {🌲}. To craft it, you'll need:
{recipe:Ecosystem}"
place = "bottom"
act = PackedStringArray("card:Ecosystem")

[sub_resource type="Resource" id="q15"]
script = ExtResource("2")
say = "Each one of those components has its own crafting recipe, like the [b]Salmon[/b] {🐟}! It's made of:
{recipe:Salmon}"
place = "top"
act = PackedStringArray("card:Salmon")

[sub_resource type="Resource" id="q16"]
script = ExtResource("2")
say = "Bigger items need a little extra to craft. You'll need to spend an [b]ORGANIC[/b] element {suit:organic} to craft the Salmon."
place = "top"
spot = PackedStringArray("cp:costs")

[sub_resource type="Resource" id="q17"]
script = ExtResource("2")
say = "The [b]Salmon[/b] {🐟} card can be crafted at the [b]Old Growth Forest[/b] {🌲}"
place = "top"
spot = PackedStringArray("cp:station")

[sub_resource type="Resource" id="q18"]
script = ExtResource("2")
say = "Items with the same icons {suit:organic}{🌲}{💧} can combine in special ways to give you more points! Let's see what combos {⚛️} we can make..."
place = "top"
spot = PackedStringArray("cp:costs", "cp:station", "cp:parts", "cp:pts")

[sub_resource type="Resource" id="q19"]
script = ExtResource("2")
say = "This is your [b]Inventory[/b] {ui:inventory}. There's nothing here yet..."
act = PackedStringArray("nocard", "inventory")

[sub_resource type="Resource" id="q20"]
script = ExtResource("2")
say = "Here are some items to get started!"
place = "top"
act = PackedStringArray("items")

[sub_resource type="Resource" id="q21"]
script = ExtResource("2")
say = "As you explore the world and craft items, you'll also need to complete [b]challenges[/b]!"
place = "top"

[sub_resource type="Resource" id="q22"]
script = ExtResource("2")
say = "Getting a high score in the challenges is the key to success!"
place = "top"
extra = "meter"

[sub_resource type="Resource" id="q23"]
script = ExtResource("2")
say = "Let's walk through a challenge now!"
place = "top"

[sub_resource type="Resource" id="q24"]
script = ExtResource("2")
say = "A challenge happens every [b]3 turns[/b] {🕒}. It's like a card game {🃏}! You'll need to use the items you've crafted so far to create a beautiful display {🌈}"
place = "top"
act = PackedStringArray("deal")
wait = "mat"

[sub_resource type="Resource" id="q25"]
script = ExtResource("2")
say = "The trick is to match item icons to create [b]combos[/b] between the cards on the Display Mat."
place = "bottom"

[sub_resource type="Resource" id="q26"]
script = ExtResource("2")
say = "These cards share a few icons {suit:organic}{💧}. Matching [b]3+[/b] icons earns you a multiplier bonus!"
place = "bottom"
act = PackedStringArray("play:Apple,Banana,Tree")
wait = "mat"

[sub_resource type="Resource" id="q27"]
script = ExtResource("2")
say = "Search for combos by [b]discarding[/b] some cards from your hand to get new ones from your inventory. But be careful! You won't get these cards back until the next challenge!"
place = "top"
act = PackedStringArray("discard:Sand,Bone")
spot = PackedStringArray("hand:discard")
wait = "mat"

[sub_resource type="Resource" id="q28"]
script = ExtResource("2")
say = "Cards add up their total score, then multiply by the combos you made!
{⚛️} [b]Quark Score[/b] = Item Score × Combo Score"
place = "bottom"
act = PackedStringArray("play:Deer,Canoe,Cloud,Chicken")
wait = "mat"

[sub_resource type="Resource" id="q29"]
script = ExtResource("2")
say = "Sometimes you might know JUST the right card to play. You can search through your deck for the right card by spending an element that matches an icon on the card."
place = "bottom"
act = PackedStringArray("view:elements")
spot = PackedStringArray("hand:draw", "el:O")

[sub_resource type="Resource" id="q30"]
script = ExtResource("2")
say = "Perfect match! Let's play the last card to complete our display."
place = "top"
act = PackedStringArray("draw:O:Egg")
wait = "mat"

[sub_resource type="Resource" id="q31"]
script = ExtResource("2")
say = "Elements are made of [b]Quarks[/b]!
More Quarks = More Elements."
place = "bottom"
act = PackedStringArray("play:Egg")
wait = "reward"

[sub_resource type="Resource" id="q32"]
script = ExtResource("2")
say = "Let's go gather {🧺} some elements now!"
place = "bottom"

