[gd_scene load_steps=13 format=3]

[ext_resource type="Script" path="res://ui/tutorial/hints.gd" id="1"]
[ext_resource type="Script" path="res://ui/tutorial/hint.gd" id="2"]

[sub_resource type="Resource" id="hint0"]
script = ExtResource("2")
id = "roll"
say = "Tap [b]Roll[/b] to gather this station's elements!"
pose = 3
target = "hub:home"
when = "screen:station&!rolled"

[sub_resource type="Resource" id="hint1"]
script = ExtResource("2")
id = "craft"
say = "You can craft this one! Tap the card, then [b]Craft[/b]."
pose = 7
target = "tip:st:craft:*"
when = "screen:station&rolled"

[sub_resource type="Resource" id="hint2"]
script = ExtResource("2")
id = "unknown"
say = "That [b]?[/b] is an Unknown Element. In [b]Convert[/b] it can become any element from this station."
pose = 5
target = "convert"
when = "screen:station&unknown"

[sub_resource type="Resource" id="hint3"]
script = ExtResource("2")
id = "convert"
say = "Three of one element? [b]Convert[/b] trades 3 for 1 of the element you need."
pose = 5
target = "convert"
when = "screen:station&rolled&canconvert"

[sub_resource type="Resource" id="hint4"]
script = ExtResource("2")
id = "map"
say = "Done here? Tap the [b]Map[/b] to travel to the next station."
pose = 12
target = "hub:home"
when = "screen:station&rolled"

[sub_resource type="Resource" id="hint5"]
script = ExtResource("2")
id = "market"
say = "Check out the [b]Market[/b]! Craft its items to finish rows and win prizes."
pose = 1
target = "hub:market"
when = "screen:map&visit:1&!marketvisited"

[sub_resource type="Resource" id="hint6"]
script = ExtResource("2")
id = "track"
say = "Tap {🔍} to track an item: the shops light up what it needs. Try its smaller parts first!"
pose = 10
target = "todo:track:*"
when = "panel:todo"

[sub_resource type="Resource" id="hint7"]
script = ExtResource("2")
id = "hand"
say = "Lift a card from your hand, then tap the mat to play it. A higher Quark Score earns more bonus dice!"
pose = 7
target = "hand"
when = "check"

[sub_resource type="Resource" id="hint8"]
script = ExtResource("2")
id = "challenge"
say = "This check's challenge: {✅} Requests multiply your Quarks, {⛔} Restrictions cut them."
pose = 1
target = "tip:order"
when = "check"

[sub_resource type="Resource" id="hint9"]
script = ExtResource("2")
id = "rules"
say = "Tap here for the Display Mat rules. A score under the first breakpoint ends your run!"
pose = 10
target = "btn:rules"
when = "check"

[node name="Hints" type="Node"]
script = ExtResource("1")
hints = Array[ExtResource("2")]([SubResource("hint0"), SubResource("hint1"), SubResource("hint2"), SubResource("hint3"), SubResource("hint4"), SubResource("hint5"), SubResource("hint6"), SubResource("hint7"), SubResource("hint8"), SubResource("hint9")])
